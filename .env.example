# ================= Demo5 RAG 问答配置 =================
# 安全提醒：真实 .env 含密钥，已加入 .gitignore，严禁提交 GitHub！
# 本文件只是模板，只放占位符，永远不要填真实密钥。

# ---------- 大模型（对话问答）----------
# 方案A（推荐，一个 Key 通用）：全部走硅基流动
# DEEPSEEK_MODEL 填硅基流动上的模型名：
#   Qwen/Qwen2.5-7B-Instruct      免费，适合课堂 Demo
#   deepseek-ai/DeepSeek-V3       效果更好，但收费（余额不足会报 402）
DEEPSEEK_API_KEY=在此粘贴你的API密钥
DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1
DEEPSEEK_MODEL=Qwen/Qwen2.5-7B-Instruct

# 方案B（可选）：大模型走 DeepSeek 官方，向量走硅基流动
# DEEPSEEK_API_KEY=DeepSeek官方Key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# EMBEDDING_API_KEY=硅基流动Key
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1

# ---------- Embedding（向量化）----------
# EMBEDDING_API_KEY 未配置时自动复用 DEEPSEEK_API_KEY（方案A无需单独配置）
# 可选向量服务：
#   硅基流动  BAAI/bge-m3        https://api.siliconflow.cn/v1              （需余额>0）
#   阿里百炼  text-embedding-v3  https://dashscope.aliyuncs.com/compatible-mode/v1（每模型免费100万token）
# 注意：更换向量化模型后必须 python rag_console.py --rebuild 重建向量库！
EMBEDDING_API_KEY=在此粘贴向量服务的Key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
