# ================= Demo4 Embedding 配置 =================
# 按课程约定，向量化服务的密钥命名为 DEEPSEEK_API_KEY
# 注意：DeepSeek 官方 API 目前不提供 Embedding 接口，
#      需在下方 EMBEDDING_BASE_URL 填写 OpenAI 兼容的向量化服务地址
# 安全提醒：本文件含密钥，真实 .env 必须加入 .gitignore，严禁提交 GitHub！

# 向量化服务密钥（复制本文件为 .env 后替换为你的真实密钥，切勿提交）
DEEPSEEK_API_KEY=在此粘贴你的API密钥

# Embedding 服务地址（OpenAI 兼容格式，通常以 /v1 结尾）
# 示例（硅基流动 SiliconFlow）：https://api.siliconflow.cn/v1
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1

# Embedding 模型名称（按所用服务商支持列表修改）
# 硅基流动：BAAI/bge-m3   阿里百炼：text-embedding-v3
EMBEDDING_MODEL=BAAI/bge-m3
